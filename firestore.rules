rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Verify signed in user
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // User Profiles
    match /profiles/{profileId} {
      allow read, write: if isSignedIn() && isValidId(profileId);
    }

    // Masters / Jobworkers
    match /masters/{masterId} {
      allow read, write: if isSignedIn() && isValidId(masterId);
    }

    // Materials / Raw Stock
    match /materials/{materialId} {
      allow read, write: if isSignedIn() && isValidId(materialId);
    }

    // Challans (Daily Material Issues)
    match /challans/{challanId} {
      allow read, write: if isSignedIn() && isValidId(challanId);
    }

    // Challan Line Items
    match /challan_items/{itemId} {
      allow read, write: if isSignedIn() && isValidId(itemId);
    }

    // Counters for Auto-increment Serial Numbers
    match /counters/{counterId} {
      allow read, write: if isSignedIn() && isValidId(counterId);
    }

    // Connection Health & Diagnostics
    match /test_connection/{docId} {
      allow read, write: if isSignedIn();
    }

    // Material Inward Entries (Stock Inward)
    match /inward_entries/{entryId} {
      allow read, write: if isSignedIn() && isValidId(entryId);
    }

    // Billing Invoices (Settlements & Invoices)
    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn() && isValidId(invoiceId);
    }

    // Invoice Challan Bridges
    match /invoice_challans/{id} {
      allow read, write: if isSignedIn() && isValidId(id);
    }

    // Master Custom Rate Overrides
    match /master_rate_overrides/{overrideId} {
      allow read, write: if isSignedIn() && isValidId(overrideId);
    }

    // Material Rate Change History
    match /rate_history/{historyId} {
      allow read, write: if isSignedIn() && isValidId(historyId);
    }

    // System Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if isSignedIn() && isValidId(logId);
    }

    // Physical Stock Corrections
    match /stock_corrections/{correctionId} {
      allow read, write: if isSignedIn() && isValidId(correctionId);
    }

    // Master Ledger Transactions
    match /ledger_transactions/{txId} {
      allow read, write: if isSignedIn() && isValidId(txId);
    }

    // Master Financial Advance Accounts
    match /master_advances/{advanceId} {
      allow read, write: if isSignedIn() && isValidId(advanceId);
    }

    // Master Advance Ledgers
    match /master_advance_ledger/{ledgerId} {
      allow read, write: if isSignedIn() && isValidId(ledgerId);
    }

    // Legacy sandbox collection catch-all for backward compatibility
    match /{collName}/{docId=**} {
      allow read, write: if isSignedIn();
    }
  }
}

