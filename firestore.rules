rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global and Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['id', 'email', 'role', 'name', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.role is string && (data.role == 'issue_dept' || data.role == 'billing' || data.role == 'admin')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.created_at is string
        && (!data.keys().contains('username') || (data.username is string && data.username.size() >= 1 && data.username.size() <= 128))
        && (!data.keys().contains('password') || (data.password is string && data.password.size() >= 1 && data.password.size() <= 128));
    }

    // Helper functions for entity schema validation
    function isValidMaster(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'type', 'is_active', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 20
        && data.type is string && (data.type == 'jacket' || data.type == 'pant')
        && data.is_active is bool
        && data.created_at is string;
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['id', 'name', 'unit', 'default_rate', 'current_stock', 'is_active', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20
        && data.default_rate is number && data.default_rate >= 0
        && data.current_stock is number && data.current_stock >= 0
        && data.is_active is bool
        && data.created_at is string;
    }

    function isValidChallan(data) {
      return data.keys().hasAll(['id', 'challan_no', 'master_id', 'issued_date', 'issued_by', 'status', 'notes', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.challan_no is string && data.challan_no.size() >= 1 && data.challan_no.size() <= 50
        && data.master_id is string && data.master_id.size() <= 128
        && data.issued_date is string
        && data.issued_by is string && data.issued_by.size() <= 200
        && data.status is string && (data.status == 'issued' || data.status == 'billed')
        && data.notes is string && data.notes.size() <= 2000
        && data.created_at is string;
    }

    function isValidChallanItem(data) {
      return data.keys().hasAll(['id', 'challan_id', 'material_id', 'qty', 'rate', 'amount', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.challan_id is string && data.challan_id.size() <= 128
        && data.material_id is string && data.material_id.size() <= 128
        && data.qty is number && data.qty >= 0
        && data.rate is number && data.rate >= 0
        && data.amount is number && data.amount >= 0
        && data.created_at is string;
    }

    function isValidInwardEntry(data) {
      return data.keys().hasAll(['id', 'material_id', 'qty_received', 'supplier_name', 'bill_no', 'inward_date', 'notes', 'created_by', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.material_id is string && data.material_id.size() <= 128
        && data.qty_received is number && data.qty_received >= 0
        && data.supplier_name is string && data.supplier_name.size() <= 200
        && data.bill_no is string && data.bill_no.size() <= 200
        && data.inward_date is string
        && data.notes is string && data.notes.size() <= 2000
        && data.created_by is string && data.created_by.size() <= 200
        && data.created_at is string;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['id', 'invoice_no', 'master_id', 'period_month', 'period_year', 'work_amount', 'material_deduction', 'net_payable', 'status', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.invoice_no is string && data.invoice_no.size() >= 1 && data.invoice_no.size() <= 50
        && data.master_id is string && data.master_id.size() <= 128
        && data.period_month is number && data.period_month >= 1 && data.period_month <= 12
        && data.period_year is number && data.period_year >= 2000 && data.period_year <= 2100
        && data.work_amount is number && data.work_amount >= 0
        && data.material_deduction is number && data.material_deduction >= 0
        && data.net_payable is number && data.net_payable >= 0
        && data.status is string && (data.status == 'draft' || data.status == 'finalised')
        && data.created_at is string;
    }

    // Match patterns for collections and fields
    match /profiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(profileId) && isValidProfile(request.resource.data);
      allow update: if isSignedIn() && isValidId(profileId) && isValidProfile(request.resource.data) && (
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin' ||
        (request.auth.uid == profileId && request.resource.data.role == resource.data.role)
      );
      allow delete: if isSignedIn() && isValidId(profileId) && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    match /masters/{masterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(masterId) && isValidMaster(request.resource.data);
      allow update: if isSignedIn() && isValidId(masterId) && isValidMaster(request.resource.data);
      allow delete: if isSignedIn() && isValidId(masterId);
    }

    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(materialId) && isValidMaterial(request.resource.data);
      allow update: if isSignedIn() && isValidId(materialId) && isValidMaterial(request.resource.data);
      allow delete: if isSignedIn() && isValidId(materialId);
    }

    match /challans/{challanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(challanId) && isValidChallan(request.resource.data);
      allow update: if isSignedIn() && isValidId(challanId) && isValidChallan(request.resource.data);
      allow delete: if isSignedIn() && isValidId(challanId);
    }

    match /challan_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(itemId) && isValidChallanItem(request.resource.data);
      allow update: if isSignedIn() && isValidId(itemId) && isValidChallanItem(request.resource.data);
      allow delete: if isSignedIn() && isValidId(itemId);
    }

    match /inward_entries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(entryId) && isValidInwardEntry(request.resource.data);
      allow update: if isSignedIn() && isValidId(entryId) && isValidInwardEntry(request.resource.data);
      allow delete: if isSignedIn() && isValidId(entryId);
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(invoiceId) && isValidInvoice(request.resource.data);
      allow update: if isSignedIn() && isValidId(invoiceId) && isValidInvoice(request.resource.data);
      allow delete: if isSignedIn() && isValidId(invoiceId);
    }

    match /invoice_challans/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id);
      allow update: if isSignedIn() && isValidId(id);
      allow delete: if isSignedIn() && isValidId(id);
    }

    match /master_rate_overrides/{overrideId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(overrideId);
      allow update: if isSignedIn() && isValidId(overrideId);
      allow delete: if isSignedIn() && isValidId(overrideId);
    }

    match /rate_history/{historyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(historyId);
      allow update: if isSignedIn() && isValidId(historyId);
      allow delete: if isSignedIn() && isValidId(historyId);
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId);
      allow update: if isSignedIn() && isValidId(logId);
      allow delete: if isSignedIn() && isValidId(logId);
    }
  }
}
